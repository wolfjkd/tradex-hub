# tradex 环境变量配置模板
# 复制为 .env 并根据需要修改，不配置也可正常运行（使用默认值）

# ── 数据源 ──────────────────────────────────────────────
# AKShare 请求超时时间（秒）
AKSHARE_TIMEOUT=30
# 腾讯行情接口超时时间（秒）
TENCENT_TIMEOUT=10
# 通达信服务器地址，auto 表示自动选择最优
ELTDX_SERVER=auto

# ── 通达信官方 MCP（tdx_mcp 数据源，v0.1.0-DEV）────────────────
# 认证：官方快期 MCP 分发的访问 token，需自行在通达信 MCP 控制台获取。
# ⚠️ 开源分发时请勿提交真实 token，留空即可——缺 token 时本源自动降级到 eltdx。
TDX_MCP_TOKEN=
# 官方 MCP 端点（通常无需改动）
TDX_MCP_ENDPOINT=https://txmcp.tdx.com.cn:3001/txmcp
# 串行限流最小间隔（秒），防官方风控；默认 0.8
TDX_MCP_MIN_INTERVAL=0.8

# ── 东财防封客户端（anti_ban_client）────────────────────
# 请求最小间隔（秒），默认 1.0
EM_RATE_LIMIT_INTERVAL=1.0
# 随机抖动范围（秒），默认 0.1~0.5
EM_JITTER_MIN=0.1
EM_JITTER_MAX=0.5
# 403 Forbidden 时最大重试次数，默认 1
EM_MAX_RETRY=1

# ── 智能路由 ────────────────────────────────────────────
# 健康检查间隔（秒）
ROUTER_HEALTH_CHECK_INTERVAL=60
# 数据源最低健康评分，低于此值不再选中
ROUTER_MIN_SCORE=20.0
# 定时恢复评分的增量
ROUTER_RECOVERY_AMOUNT=10.0

# ── MCP 服务 ────────────────────────────────────────────
# MCP 传输模式：stdio | sse | http
MCP_TRANSPORT=stdio
# MCP HTTP 网关监听地址：默认 0.0.0.0（云/容器形态，与代理无关；数据源流量始终直连）。
# 仅本机调试可改 localhost。注意本机 Clash 代理(127.0.0.1:7897)只用于 GitHub，勿作服务地址。
MCP_HOST=0.0.0.0
# MCP HTTP/SSE 模式监听端口
MCP_PORT=8000
# HTTP Host 校验白名单：默认空=仅本机回环可连；绑 0.0.0.0 对外部署填目标 IP/域名，* = 全放行(仅可信内网)
MCP_ALLOWED_HOSTS=

# ── 缓存 ────────────────────────────────────────────────
# 内存缓存最大条目数，0 表示无限
CACHE_MAX_SIZE=5000
# 文件缓存目录路径
CACHE_FILE_DIR=.cache
# 是否启用文件缓存
CACHE_FILE_ENABLED=true

# ── 技术分析 ────────────────────────────────────────────
# 技术指标计算回溯天数
INDICATOR_LOOKBACK_DAYS=400
# 筹码分布直方图分箱数
CHIP_DISTRIBUTION_BINS=50

# ── 日志 ────────────────────────────────────────────────
# 日志级别：DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# 日志文件目录
LOG_DIR=logs
