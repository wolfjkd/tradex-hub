# tradex 环境变量配置模板
# 复制为 .env 并根据需要修改，不配置也可正常运行（使用默认值）

# ── 数据源 ──────────────────────────────────────────────
# AKShare 请求超时时间（秒）
AKSHARE_TIMEOUT=30
# 腾讯行情接口超时时间（秒）
TENCENT_TIMEOUT=10
# 通达信服务器地址，auto 表示自动选择最优
ELTDX_SERVER=auto

# ── 东财防封客户端（anti_ban_client）────────────────────
# 请求最小间隔（秒），默认 1.0
EM_RATE_LIMIT_INTERVAL=1.0
# 随机抖动范围（秒），默认 0.1~0.5
EM_JITTER_MIN=0.1
EM_JITTER_MAX=0.5
# 403 Forbidden 时最大重试次数，默认 1
EM_MAX_RETRY=1

# ── 智能路由 ────────────────────────────────────────────
# 健康检查间隔（秒）
ROUTER_HEALTH_CHECK_INTERVAL=60
# 数据源最低健康评分，低于此值不再选中
ROUTER_MIN_SCORE=20.0
# 定时恢复评分的增量
ROUTER_RECOVERY_AMOUNT=10.0

# ── MCP 服务 ────────────────────────────────────────────
# MCP 传输模式：stdio | sse | http
MCP_TRANSPORT=stdio
# MCP HTTP/SSE 模式监听地址
MCP_HOST=127.0.0.1
# MCP HTTP/SSE 模式监听端口
MCP_PORT=8000

# ── 缓存 ────────────────────────────────────────────────
# 内存缓存最大条目数，0 表示无限
CACHE_MAX_SIZE=5000
# 文件缓存目录路径
CACHE_FILE_DIR=.cache
# 是否启用文件缓存
CACHE_FILE_ENABLED=true

# ── 技术分析 ────────────────────────────────────────────
# 技术指标计算回溯天数
INDICATOR_LOOKBACK_DAYS=400
# 筹码分布直方图分箱数
CHIP_DISTRIBUTION_BINS=50

# ── 日志 ────────────────────────────────────────────────
# 日志级别：DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# 日志文件目录
LOG_DIR=logs
