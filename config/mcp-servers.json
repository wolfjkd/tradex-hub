{
  "version": "3.3.11",
  "description": "tradex-hub 金融数据中枢 - MCP Server 配置（v3.3.11）",
  "servers": {
    "tradex": {
      "name": "tradex 金融数据中枢",
      "type": "stdio",
      "tools": 129,
      "modules": ["company_info", "price_data", "financial_stmt", "valuation", "industry", "market", "news_events", "macro_fx", "signal_data", "eltdx_data(31)", "technical_indicators", "performance_metrics", "signal_generation", "factor_analysis", "stock_screening", "diagnostics", "composite_analysis", "analysis_engine", "local_data(2)"],
      "version": "3.3.11",
      "note": "eltdx行情类第一主源+AKShare第二源+东财/同花顺备用，129个MCP工具，三层架构(L1数据/L2计算/L3决策)，SmartRouter 全量路由(含v3.3.2超时保护)，astock_signals 已并入本仓 src/astock_signals 为唯一主源，数据源看板 python -m tradex.dashboard"
    },
    "tdx-connector": {
      "name": "通达信 MCP",
      "type": "connector",
      "modules": ["quotes", "kline", "screener", "notice", "report", "news"],
      "source": "独立 MCP Server",
      "note": "独立connector，非tradex子模块"
    }
  },
  "routing": {
    "realtime_quote": {
      "primary": "SmartRouter: eltdx(TCP) → akshare → tencent_http",
      "fallback": ["tdx-connector"]
    },
    "historical_kline": {
      "primary": "SmartRouter: eltdx → akshare",
      "fallback": ["tdx-connector"]
    },
    "minute_data": {
      "primary": "SmartRouter: eltdx → akshare",
      "fallback": []
    },
    "call_auction": {
      "primary": "SmartRouter: eltdx [exclusive]",
      "fallback": []
    },
    "tick_data": {
      "primary": "SmartRouter: eltdx [exclusive]",
      "fallback": []
    },
    "f10_profile": {
      "primary": "SmartRouter: eltdx [exclusive]",
      "fallback": []
    },
    "financials": {
      "primary": "SmartRouter: akshare",
      "fallback": []
    },
    "industry_board": {
      "primary": "SmartRouter: akshare",
      "fallback": []
    },
    "macro": {
      "primary": "SmartRouter: akshare",
      "fallback": []
    },
    "fund_flow": {
      "primary": "SmartRouter: em_push2 → akshare",
      "fallback": []
    },
    "dragon_tiger": {
      "primary": "SmartRouter: em_datacenter → akshare",
      "fallback": []
