{
  "version": "3.0",
  "description": "Buddy 金融数据中枢 - MCP Server 配置（v3.0.0）",
  "servers": {
    "tradex": {
      "name": "tradex 金融数据中枢",
      "type": "stdio",
      "tools": 88,
      "modules": ["company_info(4)", "price_data(5)", "financial_stmt(8)", "valuation(4)", "industry(5)", "market(5)", "news_events(4)", "macro_fx(8)", "signal_data(17)", "eltdx_data(5)", "technical_indicators(6)", "performance_metrics(2)", "signal_generation(3)", "factor_analysis(2)", "stock_screening(2)", "diagnostics(4)", "composite_analysis(3)", "analysis_engine(1)"],
      "version": "3.0.0",
      "note": "AKShare主+东财直连+同花顺，88个MCP工具，三层架构(L1数据/L2计算/L3决策)"
    },
    "tdx-connector": {
      "name": "通达信 MCP",
      "type": "connector",
      "modules": ["quotes", "kline", "screener", "notice", "report", "news"],
      "source": "独立 MCP Server",
      "note": "独立connector，非tradex子模块"
    }
  },
  "routing": {
    "realtime_quote": {
      "primary": "tradex (get_realtime_price)",
      "fallback": ["tdx-connector"]
    },
    "kline": {
      "primary": "tradex (get_kline)",
      "fallback": ["tdx-connector"]
    },
    "financials": {
      "primary": "tradex (get_financial_statements)",
      "fallback": []
    },
    "industry_board": {
      "primary": "tradex (get_industry_boards)",
      "fallback": []
    },
    "macro": {
      "primary": "tradex (macro_fx)",
      "fallback": []
    },
    "dragon_tiger": {
      "primary": "tradex (get_dragon_tiger)",
      "fallback": ["signal_data (get_dragon_tiger_signal)"]
    },
    "northbound": {
      "primary": "tradex (get_northbound_flow)",
      "fallback": ["signal_data (get_northbound_flow_signal)"]
    }
  }
}
